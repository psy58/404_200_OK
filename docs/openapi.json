{
  "openapi": "3.1.0",
  "info": {
    "title": "업무 네비게이터 API",
    "description": "학교 업무 담당자의 질문에 다음 할 일과 근거 문서를 돌려주는 API. 지금은 모든 엔드포인트가 예시 데이터로 동작한다.",
    "version": "0.2.0"
  },
  "paths": {
    "/api/v1/query": {
      "post": {
        "tags": [
          "query"
        ],
        "summary": "업무에 대해 묻고 다음 할 일과 근거 문서를 받는다",
        "operationId": "post_query_api_v1_query_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QueryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueryResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/workflows": {
      "get": {
        "tags": [
          "workflows"
        ],
        "summary": "등록된 업무 목록",
        "operationId": "list_workflows_api_v1_workflows_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkflowListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/workflows/{workflow_id}": {
      "get": {
        "tags": [
          "workflows"
        ],
        "summary": "업무 흐름 조회",
        "operationId": "get_workflow_api_v1_workflows__workflow_id__get",
        "parameters": [
          {
            "name": "workflow_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "examples": [
                "science_competition"
              ],
              "title": "Workflow Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkflowDetail"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/workflows/{workflow_id}/steps/{step_id}/complete": {
      "post": {
        "tags": [
          "workflows"
        ],
        "summary": "단계 완료 처리",
        "description": "완료 처리한 뒤 갱신된 업무 흐름 전체를 돌려준다. 프론트는 응답으로 화면을 그대로 다시 그리면 되고, 따로 조회하지 않아도 된다.",
        "operationId": "complete_step_api_v1_workflows__workflow_id__steps__step_id__complete_post",
        "parameters": [
          {
            "name": "workflow_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Workflow Id"
            }
          },
          {
            "name": "step_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Step Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StepCompleteRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkflowDetail"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/workflows/{workflow_id}/feedback": {
      "post": {
        "tags": [
          "workflows"
        ],
        "summary": "실제 업무가 등록된 흐름과 다를 때 알린다",
        "operationId": "post_feedback_api_v1_workflows__workflow_id__feedback_post",
        "parameters": [
          {
            "name": "workflow_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Workflow Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FeedbackRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FeedbackResponse"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/documents/{document_id}": {
      "get": {
        "tags": [
          "documents"
        ],
        "summary": "문서 정보 조회",
        "operationId": "get_document_api_v1_documents__document_id__get",
        "parameters": [
          {
            "name": "document_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Document Id"
            }
          },
          {
            "name": "include_content",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "본문 전체가 필요할 때만 true. 기본은 메타데이터만 돌려준다.",
              "default": false,
              "title": "Include Content"
            },
            "description": "본문 전체가 필요할 때만 true. 기본은 메타데이터만 돌려준다."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentDetail"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/documents/{document_id}/chunks/{chunk_id}": {
      "get": {
        "tags": [
          "documents"
        ],
        "summary": "문서 조각 조회",
        "operationId": "get_chunk_api_v1_documents__document_id__chunks__chunk_id__get",
        "parameters": [
          {
            "name": "document_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Document Id"
            }
          },
          {
            "name": "chunk_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Chunk Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChunkDetail"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChunkDetail": {
        "properties": {
          "document_id": {
            "type": "string",
            "title": "Document Id"
          },
          "chunk_id": {
            "type": "string",
            "title": "Chunk Id",
            "examples": [
              "chunk_0142"
            ]
          },
          "title": {
            "type": "string",
            "title": "Title",
            "description": "편의를 위해 문서 제목을 함께 보낸다.",
            "examples": [
              "2026 학생 교외대회 참가 지침"
            ]
          },
          "page": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Page",
            "examples": [
              12
            ]
          },
          "content": {
            "type": "string",
            "title": "Content",
            "description": "조각 본문(Markdown)."
          },
          "prev_chunk_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Prev Chunk Id"
          },
          "next_chunk_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Chunk Id"
          }
        },
        "type": "object",
        "required": [
          "document_id",
          "chunk_id",
          "title",
          "content"
        ],
        "title": "ChunkDetail",
        "description": "근거로 인용된 조각 하나. 앞뒤 조각으로 이동할 수 있다."
      },
      "DocumentDetail": {
        "properties": {
          "document_id": {
            "type": "string",
            "title": "Document Id",
            "examples": [
              "doc_2026_competition_guide"
            ]
          },
          "title": {
            "type": "string",
            "title": "Title",
            "examples": [
              "2026 학생 교외대회 참가 지침"
            ]
          },
          "source_type": {
            "$ref": "#/components/schemas/SourceType"
          },
          "doc_number": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Doc Number",
            "description": "공문서 번호. 학교 문서가 아니면 null.",
            "examples": [
              "숭의여자고등학교-10129"
            ]
          },
          "issued_on": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Issued On",
            "description": "생산 또는 접수 일자."
          },
          "page_count": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Page Count",
            "examples": [
              24
            ]
          },
          "chunk_count": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Chunk Count",
            "examples": [
              87
            ]
          },
          "original_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Original Url",
            "description": "원본 파일을 받을 수 있는 경로. 없으면 null."
          },
          "content": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content",
            "description": "문서 전체를 Markdown으로 변환한 본문. 기본은 null이며 include_content=true 로 요청할 때만 채워진다."
          }
        },
        "type": "object",
        "required": [
          "document_id",
          "title",
          "source_type",
          "chunk_count"
        ],
        "title": "DocumentDetail",
        "description": "문서 제목과 원문 보기 링크를 그리는 데 필요한 정보."
      },
      "DocumentResult": {
        "properties": {
          "document_id": {
            "type": "string",
            "title": "Document Id",
            "examples": [
              "doc_2026_competition_guide"
            ]
          },
          "chunk_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Chunk Id",
            "examples": [
              "chunk_0142"
            ]
          },
          "title": {
            "type": "string",
            "title": "Title",
            "examples": [
              "2026 학생 교외대회 참가 지침"
            ]
          },
          "page": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Page",
            "examples": [
              12
            ]
          },
          "snippet": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Snippet",
            "description": "원문 미리보기. 화면에 그대로 보여줄 수 있는 길이로 잘라서 보낸다.",
            "examples": [
              "교외대회 참가 신청은 대회 개최일 30일 전까지 학교장 결재를 거쳐..."
            ]
          },
          "relevance": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Relevance",
            "examples": [
              0.87
            ]
          }
        },
        "type": "object",
        "required": [
          "document_id",
          "title",
          "relevance"
        ],
        "title": "DocumentResult",
        "description": "답변의 근거가 된 문서 조각.\n\ndocument_id와 chunk_id는 그대로 문서 조회 API의 경로에 쓰인다.\nGET /api/v1/documents/{document_id}\nGET /api/v1/documents/{document_id}/chunks/{chunk_id}"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code",
            "description": "프론트가 분기에 쓰는 코드. 사람이 읽는 문구는 message를 쓴다.",
            "examples": [
              "workflow_not_found"
            ]
          },
          "message": {
            "type": "string",
            "title": "Message",
            "examples": [
              "요청한 업무를 찾을 수 없습니다."
            ]
          },
          "details": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details",
            "description": "검증 실패(422)일 때 어떤 필드가 왜 틀렸는지.",
            "examples": [
              [
                {
                  "field": "body.query",
                  "reason": "String should have at least 1 character"
                }
              ]
            ]
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "description": "4xx/5xx 응답의 공통 형태. 프론트는 error.code로 분기한다."
      },
      "FeedbackRequest": {
        "properties": {
          "type": {
            "$ref": "#/components/schemas/FeedbackType"
          },
          "after_step_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "After Step Id",
            "description": "기준이 되는 단계. 이 단계 다음에 차이가 있다는 뜻이다. null이면 워크플로 맨 앞을 가리킨다.",
            "examples": [
              "2"
            ]
          },
          "suggested_step_name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Suggested Step Name",
            "description": "missing_step일 때 실제로 했던 일의 이름.",
            "examples": [
              "개인정보 동의"
            ]
          },
          "description": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Description",
            "description": "담당자가 직접 쓴 설명. 이후 워크플로 개선 검토에 쓴다."
          },
          "query_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Query Id",
            "description": "이 피드백을 유발한 /query 응답이 있으면 그 식별자."
          }
        },
        "type": "object",
        "required": [
          "type",
          "description"
        ],
        "title": "FeedbackRequest"
      },
      "FeedbackResponse": {
        "properties": {
          "feedback_id": {
            "type": "string",
            "title": "Feedback Id",
            "examples": [
              "fb_01HZX4A2"
            ]
          },
          "workflow_id": {
            "type": "string",
            "title": "Workflow Id"
          },
          "type": {
            "$ref": "#/components/schemas/FeedbackType"
          },
          "diff": {
            "$ref": "#/components/schemas/WorkflowDiff"
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "담당자에게 보여줄 접수 확인 문구.",
            "examples": [
              "의견이 접수되었습니다. 워크플로 개선 검토에 반영됩니다."
            ]
          }
        },
        "type": "object",
        "required": [
          "feedback_id",
          "workflow_id",
          "type",
          "diff",
          "message"
        ],
        "title": "FeedbackResponse"
      },
      "FeedbackType": {
        "type": "string",
        "enum": [
          "missing_step",
          "unnecessary_step",
          "wrong_order",
          "wrong_document",
          "other"
        ],
        "title": "FeedbackType",
        "description": "실제 업무가 등록된 워크플로와 다를 때, 어떻게 다른지."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "NextAction": {
        "properties": {
          "step_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Step Id",
            "examples": [
              "3"
            ]
          },
          "title": {
            "type": "string",
            "title": "Title",
            "examples": [
              "참가 신청서 제출"
            ]
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description",
            "examples": [
              "대회 운영 계획서와 학생 명단을 첨부해 신청서를 제출합니다."
            ]
          }
        },
        "type": "object",
        "required": [
          "title"
        ],
        "title": "NextAction",
