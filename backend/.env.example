# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 저장소에 올라가지 않습니다.

# OpenAI API 키
OPENAI_API_KEY=sk-...

# 인덱스별 임베딩 모델
#   Summary Index  문서 요약 1,000여 건 → 품질 우선
#   Chunk Index    조각 7,000여 개 → 비용 우선
SUMMARY_EMBEDDING_MODEL=text-embedding-3-large
CHUNK_EMBEDDING_MODEL=text-embedding-3-small

# 문서 요약 생성 모델 (gpt-4.1, gpt-5, gpt-4.1-mini 등)
SUMMARY_MODEL=gpt-4.1

# 벡터 저장소 위치 (비워 두면 backend/data/vectors,
# 프로젝트 경로에 한글이 있으면 %LOCALAPPDATA%\work-navigator\vectors)
# VECTOR_DIR=

# 답변 문장을 만드는 모델
ANSWER_MODEL=gpt-4.1-mini
